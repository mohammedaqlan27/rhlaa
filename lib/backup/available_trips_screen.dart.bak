import 'package:flutter/material.dart';
import 'package:cloud_firestore/cloud_firestore.dart';
import '../models/trip.dart';
import '../widgets/trip_card.dart';
import 'trip_details_screen.dart';

class AvailableTripsScreen extends StatelessWidget {
  final String destination;
  final String? tripCategory;
  final String? vehicleType;

  const AvailableTripsScreen({
    super.key,
    required this.destination,
    this.tripCategory,
    this.vehicleType,
  });

  /// جلب الرحلات المتاحة من Firebase
  Future<List<Trip>> _fetchTrips() async {
    try {
      Query query = FirebaseFirestore.instance
          .collection('trips')
          .where('destination', isEqualTo: destination)
          .where('status', isEqualTo: 'مفعّلة')
          .where('availableSeats', isGreaterThan: 0);

      if (tripCategory != null) {
        query = query.where('tripCategory', isEqualTo: tripCategory);
      }

      if (vehicleType != null) {
        query = query.where('vehicleType', isEqualTo: vehicleType);
      }

      final snapshot = await query.orderBy('date').get();
      return snapshot.docs.map((doc) => Trip.fromDocument(doc)).toList();
    } catch (e) {
      print('❌ خطأ في جلب الرحلات: $e');
      return [];
    }
  }

  /// بناء قائمة الرحلات
  Widget buildTripList(List<Trip> trips, BuildContext context) {
    return ListView.builder(
      padding: const EdgeInsets.all(16),
      itemCount: trips.length,
      itemBuilder: (context, index) {
        final trip = trips[index];
        return TripCard(
          trip: trip,
          onTap: () {
            Navigator.push(
              context,
              MaterialPageRoute(
                builder: (_) => TripDetailsScreen(trip: trip),
              ),
            );
          },
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('الرحلات المتاحة'),
        backgroundColor: Colors.blue.shade900,
        centerTitle: true,
      ),
      body: FutureBuilder<List<Trip>>(
        future: _fetchTrips(),
        builder: (context, snapshot) {
          if (snapshot.connectionState == ConnectionState.waiting) {
            return const Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  CircularProgressIndicator(),
                  SizedBox(height: 12),
                  Text('جاري تحميل الرحلات...', style: TextStyle(fontSize: 16)),
                ],
              ),
            );
          }

          if (snapshot.hasError) {
            return const Center(
              child: Text('حدث خطأ أثناء تحميل الرحلات. حاول مرة أخرى لاحقًا.'),
            );
          }

          final trips = snapshot.data ?? [];
          if (trips.isEmpty) {
            return const Center(
              child: Text('لا توجد رحلات متاحة حالياً لهذه الوجهة.'),
            );
          }

          return buildTripList(trips, context);
        },
      ),
    );
  }
}
